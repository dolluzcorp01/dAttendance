# Copy to .env and fill in. NEVER commit the real .env.

# The API base the React build talks to in production.
REACT_APP_API=https://dattendance.dolluzcorp.com

# Same MySQL host as every other dApp.
DB_HOST=
DB_USER=
DB_PASSWORD=
# Not used directly - config/db.js opens a pool per database by name
# (dadmin, dtime, dattendance). The user needs SELECT on dadmin + dtime and
# full rights on dattendance.
DB_NAME=dattendance

# MUST be byte-identical to dAdmin's JWT_SECRET. A session issued by dAdmin
# or Inside D has to verify here, and vice versa.
JWT_SECRET=

# The API port. nginx proxies dattendance.dolluzcorp.com to it, so this and the
# nginx site config move together. The React dev server picks its own port
# (3000, or the next one free) and needs nothing set here.
DATTENDANCE_PORT=4010

# ── two-factor sign-in and password reset (sql/004) ──
# The same SendGrid account the other dApps use. Without it the server refuses
# to issue a code in production; in development it logs the code to the console
# instead so you can sign in without live mail.
SENDGRID_API_KEY=
DATTENDANCE_FROM_EMAIL="dAttendance" <connect@dolluzcorp.com>
OTP_LENGTH=6
BCRYPT_ROUNDS=10
