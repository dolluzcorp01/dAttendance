# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# ── secrets ──────────────────────────────────────────────────────────────
# .env holds the DB password and JWT_SECRET. Ignore every variant and then
# re-allow the checked-in template, so a new .env.production can never be
# committed by accident.
.env
.env.*
!.env.example

# ── logs / runtime ───────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
/logs

# ── editors and OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/

# .vscode is deliberately NOT ignored - launch.json is what makes F5 run the
# backend, and it should work the same for everyone who clones this.
